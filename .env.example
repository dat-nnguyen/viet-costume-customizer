# Khóa Google Gemini API (Server-Side Only - Bảo mật 100%, không bị lộ ở client)
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cổng chạy Backend Server (Mặc định 3001)
PORT=3001

# Chuỗi kết nối Database:
# - Để trống: Tự động dùng built-in SQLite (data/viet_costume.db) zero-config
# - Dùng Azure Database for PostgreSQL: postgres://username:password@your-azure-server.postgres.database.azure.com:5432/viet_costume?sslmode=require
DATABASE_URL=
